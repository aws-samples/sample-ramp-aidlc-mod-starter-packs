{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-lock-v1.schema.json",
  "title": "RAMP immutable upstream skill lock v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "commit",
          "path",
          "treeSha256",
          "files",
          "license",
          "licensePath",
          "licenseFile",
          "noticePath",
          "noticeFile"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/identifier"
          },
          "source": {
            "$ref": "#/$defs/identifier"
          },
          "commit": {
            "$ref": "#/$defs/commit"
          },
          "path": {
            "$ref": "#/$defs/portablePath"
          },
          "treeSha256": {
            "$ref": "#/$defs/sha256"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "path": {
                  "const": "SKILL.md"
                }
              },
              "required": [
                "path"
              ]
            },
            "items": {
              "$ref": "#/$defs/fileRecord"
            }
          },
          "license": {
            "$ref": "#/$defs/license"
          },
          "licensePath": {
            "$ref": "#/$defs/portablePath"
          },
          "licenseFile": {
            "$ref": "#/$defs/fileRecord"
          },
          "noticePath": {
            "$ref": "#/$defs/portablePath"
          },
          "noticeFile": {
            "$ref": "#/$defs/fileRecord"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileRecord": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size",
        "executable"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*(?:\\s+(?:AND|OR|WITH)\\s+[A-Za-z0-9][A-Za-z0-9.+-]*)*$"
    },
    "portablePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?:(?!(?:\\.|\\.\\.)(?:/|$))[^/\\\\\\u0000\\t\\r\\n]+)(?:/(?!(?:\\.|\\.\\.)(?:/|$))[^/\\\\\\u0000\\t\\r\\n]+)*$"
    }
  }
}
